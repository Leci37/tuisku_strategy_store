# Cópialo a .env (git lo ignora). Sólo lo lee `python app.py`, en desarrollo;
# en un servidor las variables las pone el alojamiento.

# ── Comunes a todas las herramientas zlecitool (CONTRATO.md del núcleo) ──

# OBLIGATORIO. Firma la sesión. El MISMO en todas las herramientas: es lo que
# hace que entrar en una sea haber entrado en todas. Genera uno con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Raíz de datos común. Vacío = data/ junto a la app.
ZLECITOOL_DATA_DIR=
# Dónde se guardan los documentos y la caché de PDF: local (en la raíz de datos)
# o s3 (con ZLECITOOL_S3_BUCKET…). Con más de un servidor, s3 (o una raíz de
# datos compartida): desde el núcleo 0.30, también las marcas de las cuentas
# borradas, para cerrarlas otra vez después de volver a una copia.
# ZLECITOOL_STORAGE=local

# Base de datos común. Vacío = SQLite en <ZLECITOOL_DATA_DIR>/zlecitool.db.
# Para compartir cuentas entre herramientas en local, la MISMA en todas,
# p. ej. sqlite:////home/yo/tools/zlecitool.db. En producción, Postgres.
DATABASE_URL=

# Producción con Postgres detrás de PgBouncer (modo transaction): DATABASE_URL
# apunta a PgBouncer (puerto 6432) y esto lo dice. Las cuentas de conexiones y
# un pgbouncer.ini de ejemplo: CONTRATO.md del núcleo, §4, y su docs/pgbouncer.ini.
# ZLECITOOL_DB_POOL=pgbouncer
# Conexiones que guarda cada proceso (con PgBouncer, 4; 0 = ninguna).
# ZLECITOOL_DB_POOL_SIZE=4
# Postgres SIN PgBouncer (puerto 5432), para pg_dump: sin ella, detrás de
# PgBouncer no hay copias de seguridad.
# ZLECITOOL_DB_DIRECT_URL=postgresql://zlecitool:…@127.0.0.1:5432/zlecitool

# Sólo con las herramientas en subdominios (exam-c1.tudominio.com…). Las
# públicas, en producción: .tudominio.com (Bancada va en su subdominio), cuando
# todas van en el núcleo 0.26 o después: el núcleo caduca las cookies de antes
# que iban sólo al host. Nunca en una de empresa. En local y con rutas, vacío.
ZLECITOOL_COOKIE_DOMAIN=

# Cuántos proxies hay delante en producción (nginx, balanceador…): normalmente 1.
ZLECITOOL_TRUSTED_PROXIES=

# Los datos del titular para las páginas legales (/legal/…), comunes a todas
# las herramientas. Sin ellos, las páginas enseñan «[pendiente: …]».
ZLECITOOL_LEGAL_OWNER=
ZLECITOOL_LEGAL_TAXID=
ZLECITOOL_LEGAL_ADDRESS=
ZLECITOOL_LEGAL_EMAIL=

# Producción: además de la salida estándar, logs en <dir>/<slug>.log.
ZLECITOOL_LOG_DIR=

# Créditos, comunes a todas las herramientas (el saldo es uno). Vacíos = los de
# por defecto: 15 de regalo a cada cuenta nueva; paquetes de 25/50/150/500 por
# 2,49/4,99/9,99/24,99 € (créditos:céntimos; el de 25, desde el núcleo 0.22).
ZLECITOOL_WELCOME_CREDITS=
ZLECITOOL_CREDIT_PACKS=
# La pasarela de pago (aún ninguna conectada: sin ella no se vende) y el
# secreto con que firma sus avisos de pago (POST /zt/credits/webhook).
ZLECITOOL_PAYMENT_PROVIDER=
ZLECITOOL_PAYMENT_WEBHOOK_SECRET=

# IA: la tienda no la usa. El lanzador de la familia escribe el mismo .env en
# todas las herramientas (con ZLECITOOL_AI_FAKE=1), y aquí no estorba.

# La dirección pública, sin ruta (https://tuisku.ai, o https://exam-c1.tuisku.ai
# con subdominios): los enlaces de los correos (también los de las tareas y los
# trabajos), la URL canónica, el sitemap. Con una ruta, no arranca.
# Obligatoria en producción: sin ella no salen el enlace de «olvidé mi
# contraseña» ni el de entrar con un enlace por correo, ni (núcleo 0.30) el
# enlace de borrar la cuenta; los correos del adiós y de «Descargar mis datos»
# salen sin el suyo. Y los de la tienda: la vuelta de PayPal, la gratis, el
# recibo, confirmar un correo. En desarrollo, vacía: se usa la de la petición.
# La tienda va en su dominio o un subdominio, nunca en una ruta
# (tuisku.ai/edgefolio): sus direcciones son de la raíz (/api/…, /s/<id>). Por
# eso no lleva ZLECITOOL_PUBLIC_PATH, y el proxy borra X-Forwarded-Prefix
# (nginx: proxy_set_header X-Forwarded-Prefix "";).
ZLECITOOL_PUBLIC_URL=
# Un entorno de pruebas publicado: 1 y ningún buscador lo indexa.
# ZLECITOOL_NOINDEX=1

# Correo: «olvidé mi contraseña», el enlace para entrar (núcleo 0.26), el aviso
# de cada mensaje de contacto y los de la tienda (la descarga gratis, confirmar
# un correo, los avisos, el recibo). Sin SMTP (desarrollo), cada correo se
# escribe en <datos>/mail/*.eml.
ZLECITOOL_SMTP_HOST=
# ZLECITOOL_SMTP_PORT=587
# ZLECITOOL_SMTP_SECURITY=starttls
# ZLECITOOL_SMTP_USER=
# ZLECITOOL_SMTP_PASSWORD=
# ZLECITOOL_MAIL_FROM="tuisku <hola@tuisku.ai>"
# A quién avisar de cada mensaje de contacto (por defecto, ZLECITOOL_ADMINS).
# ZLECITOOL_CONTACT_TO=

# La caché de PDF del almacén (_cache/): cada día se borra lo que lleva más de
# estos días (a la hora de las copias, o a las 04:00 UTC). 0 = nunca sola
# (a mano: flask --app app zt cache sweep).
# ZLECITOOL_PDF_CACHE_DAYS=30

# Copias de seguridad: una cada día a esta hora (UTC), y cuántas se guardan.
# Sin ella, sólo a mano: flask --app app zt backup (o un cron). Una cuenta
# borrada sigue en las copias hasta que salen de estas (núcleo 0.30): después de
# volver a una, flask --app app zt privacy reclose antes de abrir las puertas.
# ZLECITOOL_BACKUP_DAILY_AT=03:30
# ZLECITOOL_BACKUP_KEEP=14

# Avisos de errores (un 500, un trabajo que muere): por correo a estos (por
# defecto, ZLECITOOL_ADMINS) y, si se quiere, también a Sentry
# (pip install zlecitool-core[sentry]).
# ZLECITOOL_ALERTS_TO=
# ZLECITOOL_SENTRY_DSN=
# ZLECITOOL_ENVIRONMENT=production

# Métricas (/zt/admin): los correos que ven el panel, separados por comas (los
# mismos en todas las herramientas; para el resto, 404), y cuántos euros vale
# un dólar para calcular el margen (ingresos − coste de la IA). Desde el núcleo
# 0.26, cada uno con su correo demostrado (entrar una vez con un enlace por
# correo, «Olvidé mi contraseña» o flask --app app zt user create <correo>
# --reset --proven): si no, el panel es un 404. Desde la 0.31, el panel les pide
# además un segundo factor (la primera vez, los lleva a ponerlo).
ZLECITOOL_ADMINS=
# ZLECITOOL_USD_EUR=0.92

# Segundo factor (núcleo 0.31): la clave con que se cifra la de cada app de
# códigos. La MISMA en todas las herramientas, otra que FLASK_SECRET_KEY y de
# 32 caracteres o más (como FLASK_SECRET_KEY, con secrets.token_urlsafe(48)).
# En producción, sin ella no hay app de códigos (las llaves de acceso y los
# códigos de recuperación, sí); en desarrollo, una sacada de FLASK_SECRET_KEY.
# ZLECITOOL_FACTOR_KEY=

# Registro de auditoría (núcleo 0.31): cuántos días se guarda, de 30 a 3650,
# el mismo en todas (por defecto, 365).
# ZLECITOOL_AUDIT_DAYS=365

# ── Propias de esta herramienta ──

# Puerto. Una herramienta distinta en cada puerto para tener varias abiertas a
# la vez; en localhost la cookie vale para todos los puertos, así que la
# sesión se comparte también en local. La tienda, en el 5105 (el del lanzador).
PORT=5105

# PayPal: fake (sin PayPal: «Pagar» va directo a la página de gracias, como si
# se hubiera pagado), sandbox o live. Con sandbox o live hacen falta las dos
# claves de una app REST del panel de desarrolladores de PayPal y
# ZLECITOOL_PUBLIC_URL (la vuelta de PayPal se hace con ella).
PAYPAL_MODE=fake
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Códigos de descuento: código=porcentaje, separados por comas
# (spring20=0.20,partner40=0.40). Y los de precio único para cada estrategia
# suelta (launch=0.99). Nunca llegan al navegador.
DISCOUNT_CODES=demo20=0.20
FLAT_PRICE_CODES=
# Tope del descuento por importe más el del código, juntos.
# MAX_DISCOUNT=0.70

# Los enlaces de descarga: cuántos días valen y cuántas descargas tiene cada uno.
# DOWNLOAD_DAYS=7
# MAX_DOWNLOADS=10
# «Crea tu pack»: cuántas estrategias y por cuánto (en dólares).
# PACK_SIZE=5
# PACK_PRICE=249
# Los días que una estrategia sale en «Nuevas».
# NEW_DAYS=30
# La dirección que la página da para los problemas.
# CONTACT_EMAIL=sales@tuisku.ai

# Los scripts de pago (los .pine que se venden). Vacío: <ZLECITOOL_DATA_DIR>/edgefolio/strategies,
# donde los deja `flask --app app edgefolio restore-scripts`.
STRATEGIES_DIR=

# Producción (gunicorn.conf.py): procesos, hilos y espera máxima.
# WEB_CONCURRENCY=9
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=360
# GUNICORN_MAX_REQUESTS=10000
# Detrás de un balanceador que reutiliza conexiones: más que su espera (75 con un ALB de 60).
# GUNICORN_KEEPALIVE=2
